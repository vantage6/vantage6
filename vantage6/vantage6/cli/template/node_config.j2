# override the chart name
nameOverride: {{ nameOverride | default('vantage6-node') }}
# The node and the algorithms it runs live in one Kubernetes namespace. By default
# that is the namespace you start the node in (`v6 node start --namespace`).
{# `namespace` is also a Jinja global, so test for a string #}
{% if namespace is string %}
namespace: {{ namespace }}
{% else %}
# namespace: vantage6-node
{% endif %}
node:

  name: {{ node.name | default('put-your-node-name-here') }}
  apiKey: {{ node.apiKey | default('put-your-api-key-here') }}

  # When true, the node verifies at startup that algorithm network isolation is
  # enforced by the Kubernetes cluster (NetworkPolicies). Set to false for
  # development and sandbox environments only.
  production: {{ node.production | default(true) }}

  # Keycloak configuration
  keycloak:
    url: {{ node.keycloak.url | default('http://vantage6-auth-kc-service.vantage6.svc.cluster.local:7680') }}
    realm: {{ node.keycloak.realm | default('vantage6') }}

  # Settings for HQ to connect to.
  hq:
    url: {{ node.hq.url }}
    port: {{ node.hq.port | default(7601) }}
    path: {{ node.hq.path | default('/hq') }}

  {% if node.image is defined %}
  # Fixed image to use to run the node. Note that if specified, the node will not
  # automatically run the version matching the HQ version.
  image: {{ node.image }}
  {% else %}
  # You may specify a fixed image to use to run the node. Note that if specified, the
  # node will not automatically run the version matching the HQ version.
  # image: ghcr.io/vantage6/infrastructure/node:uluru
  {% endif %}

  # Node image pull policy.
  # Possible values are:
  # - Always: always pull the image from the registry
  # - IfNotPresent: pull the image from the registry if it is not present on the node
  # - Never: never pull the image from the registry
  imagePullPolicy: {{ node.imagePullPolicy | default('Always') }}

  {% if node.k8sNodeName is defined %}
  # Development only: Kubernetes machine that holds the host path volumes.
  k8sNodeName: {{ node.k8sNodeName }}
  {% endif %}

  # Service account of the node pod. The chart binds it to a Role that lets it
  # manage jobs, pods and secrets of algorithm runs in the node's namespace.
  {% set sa = node.serviceAccount | default({}) %}
  serviceAccount:
    create: {{ sa.create | default(true) }}
    {% if sa.name is defined %}
    name: {{ sa.name }}
    {% endif %}

  # Resource requests and limits, security context and runtime class of the node
  # pod. Some clusters reject pods without resource requests and limits.
  resources: {{ node.resources | default({}) | tojson }}
  podSecurityContext: {{ node.podSecurityContext | default({}) | tojson }}
  securityContext: {{ node.securityContext | default({}) | tojson }}
  runtimeClassName: "{{ node.runtimeClassName | default('') }}"

  # Settings of the pods (Kubernetes jobs) that run algorithms. These also apply to
  # the short-lived pods the node starts to check its permissions and network
  # isolation.
  {% set ap = node.algorithmPods | default({}) %}
  algorithmPods:
    resources: {{ ap.resources | default({}) | tojson }}
    # Remove finished jobs after this many seconds, even when the node did not do
    # so itself. Set to null to disable.
    ttlSecondsAfterFinished: {{ ap.ttlSecondsAfterFinished | default(86400) | tojson }}
    # Service account to run algorithm pods with. Its token is never mounted.
    serviceAccountName: "{{ ap.serviceAccountName | default('') }}"
    runtimeClassName: "{{ ap.runtimeClassName | default('') }}"
    podSecurityContext: {{ ap.podSecurityContext | default({}) | tojson }}
    securityContext: {{ ap.securityContext | default({}) | tojson }}

  logging:
    # Controls the logging output level. Could be one of the following
    # levels: CRITICAL, ERROR, WARNING, INFO, DEBUG, NOTSET
    level: {{ node.logging.level | default('INFO') }}

    # Location to the log file
    file: {{ node.logging.file | default('node.log') }}

    # Store log files on a PersistentVolumeClaim. If false, log files only last as
    # long as the pod (console logging is unaffected).
    persistent: {{ node.logging.persistent | default(true) }}

    # Use an existing claim instead of creating one
    existingClaim: "{{ node.logging.existingClaim | default('') }}"

    # Size of the claim for logs
    storageSize: {{ node.logging.storageSize | default('1Gi') }}

    # Storage class of the claim for logs. Empty uses the cluster default.
    storageClass: "{{ node.logging.storageClass | default('') }}"

    {% if node.logging.volumeHostPath is defined %}
    # Development only: store logs in this directory on `k8sNodeName`
    volumeHostPath: {{ node.logging.volumeHostPath }}
    {% endif %}

    # Size in kb of a single log file
    max_size: {{ node.logging.max_size | default(1024) }}
    use_console: {{ node.logging.use_console | default(true) }}

    # Date format for the log file
    datefmt: "{{ node.logging.datefmt | default('%Y-%m-%d %H:%M:%S') }}"

    # Format for the log file
    format: "{{ node.logging.format | default('%(asctime)s - %(name)-14s - %(levelname)-8s - %(message)s') }}"

    # Maximum number of log files to keep. Log files are rotated when the size of the
    # current log file exceeds `max_size`.
    backup_count: {{ node.logging.backup_count | default(5) }}

    # Loggers to include in the log file
    loggers:
    {% if node.logging.loggers is defined %}
    {% for logger in node.logging.loggers %}
    - level: {{ logger.level }}
      name: {{ logger.name }}
    {% endfor %}
    {% endif %}
    {% if node.logging.loggers is not defined %}
    - level: warning
      name: urllib3
    - level: warning
      name: socketIO-client
    - level: warning
      name: socketio.server
    - level: warning
      name: engineio.server
    - level: warning
      name: sqlalchemy.engine
    - level: warning
      name: kubernetes.client.rest
    {% endif %}

  {% if node.encryption is defined %}
  encryption:
    # Whether encryption is enabled or not. This should be the same as the `encrypted`
    # setting on HQ of the collaboration to which this node belongs. If enabled, create
    # the private key with `v6 node create-private-key`.
    enabled: {{ node.encryption.enabled | default(false) }}
  {% else %}
  encryption:
    # Whether encryption is enabled or not. This should be the same as the `encrypted`
    # setting on HQ of the collaboration to which this node belongs. If enabled, create
    # the private key with `v6 node create-private-key`.
    enabled: false
  {% endif %}

  # Port for the node proxy to run on
  proxyPort: {{ node.proxyPort | default(7654) }}

  # Storage shared by the node and its algorithm pods, holding the input, output and
  # session files of algorithm runs. Each algorithm pod only mounts the files of its
  # own run.
  {% set tasks = (node.persistence | default({})).tasks | default({}) %}
  persistence:
    tasks:
      # Use an existing PersistentVolumeClaim instead of creating one
      existingClaim: "{{ tasks.existingClaim | default('') }}"
      # Folder inside the claim to use. Empty uses the root of the claim.
      subPath: "{{ tasks.subPath | default('') }}"
      # Storage class of the claim. Empty uses the cluster default.
      storageClass: "{{ tasks.storageClass | default('') }}"
      # ReadWriteOnce: algorithm pods run on the same machine as the node.
      # ReadWriteMany: algorithm pods can run on any machine (needs a storage class
      # that supports it).
      accessMode: {{ tasks.accessMode | default('ReadWriteOnce') }}
      size: {{ tasks.size | default('10Gi') }}
      {% if tasks.hostPath is defined %}
      # Development only: store task files in this directory on `k8sNodeName`
      hostPath: {{ tasks.hostPath }}
      {% endif %}

  # Network policies that isolate algorithm pods: they may only reach the node proxy
  # and DNS, plus what is added in `whitelist` below.
  {% set np = node.networkPolicy | default({}) %}
  networkPolicy:
    # Set to false if you are not allowed to create NetworkPolicies. Your cluster
    # administrator must then isolate algorithm pods in another way.
    enabled: {{ np.enabled | default(true) }}
    # Check at startup that algorithm pods cannot reach the internet. With
    # `production: true` the node refuses to start if they can. Only disable this
    # when isolation is enforced in another way.
    verifyIsolation: {{ np.verifyIsolation | default(true) }}
    # Where the cluster DNS runs. On OpenShift: namespace openshift-dns, ports [5353]
    dns: {{ np.dns | default({"namespace": "kube-system", "ports": [53]}) | tojson }}
    # Image for the isolation check. Empty uses the curl image published with vantage6.
    probeImage: "{{ np.probeImage | default('') }}"


  # It is also possible not to specify the details of the service-based databases
  # here. The node will then automatically detect the databases in the environment
  # variables. This allows parent charts to specify the databases in their own
  # values.yaml file or define them runtime using the CLI.
  #
  # In this case, the node expects the following environment variables to be set:
  #
  # DATABASE_LABELS: comma-separated list of database labels
  # DATABASE_[LABEL]_URI: URI of the database
  # DATABASE_[LABEL]_TYPE: type of the database
  #
  # Optionally, you can also specify additional environment variables for each
  # database by setting the DATABASE_[LABEL]_SOME_OTHER_KEY variable.
  #
  # DATABASE_[LABEL]_SOME_OTHER_KEY: some_other_value
  #
  # It is recommended to do this through Kubernetes secrets. If you specify the
  # details here, secrets will be used. File-based databases are automatically made
  # available to your node.
  {% if node.databases is defined %}
  databases:
    {% if node.databases.fileBased is defined %}
    fileBased:
    {% for db in node.databases.fileBased %}
    - name: {{ db.name }}
      type: {{ db.type }}
      {% if db.existingClaim is defined %}
      # PersistentVolumeClaim in the node's namespace that holds the data
      existingClaim: {{ db.existingClaim }}
      # File or folder inside the claim
      subPath: "{{ db.subPath | default('') }}"
      {% endif %}
      {% if db.volumePath is defined %}
      # Development only: directory on `k8sNodeName` and the file in it
      volumePath: {{ db.volumePath }}
      originalName: {{ db.originalName }}
      {% endif %}
      # OPTIONAL: controls how file/folder databases are exposed to algorithm
      # containers.
      # - ro (default): mounted read-only in algorithm containers
      # - copy: algorithms get a writable copy of the file
      mount_mode: {{ db.mount_mode | default('ro') }}
    {% endfor %}
    {% endif %}
    {% if node.databases.serviceBased is defined %}
    serviceBased:
    {% for db in node.databases.serviceBased %}
    - name: {{ db.name }}
      uri: {{ db.uri }}
      type: {{ db.type }}
      env:
        {% for key, value in db.env.items() %}
        {{ key }}: {{ value }}
        {% endfor %}
    {% endfor %}
    {% endif %}
  {% else %}
  databases: []
  {% endif %}

  # Whether or not your node shares some configuration (e.g. which images are
  # allowed to run on your node) with HQ. This can be useful
  # for other organizations in your collaboration to understand why a task
  # is not completed. Obviously, no sensitive data is shared. Default true
  share_config: {{ node.share_config | default(true) }}

  # Whether or not to share algorithm logs with HQ. Otherwise they will
  # only be displayed as part of the node logs. Default is true.
  # NOTE: It's recommented to set this to false when using sensitive data
  share_algorithm_logs: {{ node.share_algorithm_logs | default(true) }}

  # Whether the node may fall back to HTTP long-polling for its socket connection
  # with HQ. By default, only websockets are used, which is more stable. Only set
  # this to true if your network does not support websocket connections.
  allow_http_polling: {{ node.allow_http_polling | default(false) }}

  # Define who is allowed to run which algorithms on this node.
  {% if node.policies is defined %}
  policies:
    # Control which algorithm images are allowed to run on this node. This is
    # expected to be a valid regular expression. If `production` is true, you must set
    # this and/or `allowed_algorithm_stores`, otherwise the node will not start.
    {% if node.policies.allowed_algorithms is defined %}
    allowed_algorithms:
      {% for algo in node.policies.allowed_algorithms %}
      - {{ algo }}
      {% endfor %}
    {% else %}
    # allowed_algorithms:
    #   - ^ghcr\.io/vantage6/algorithm/[a-zA-Z]+/[a-zA-Z]+
    #   - ^myalgorithm\.ai/some-algorithm
    {% endif %}

    # It is also possible to allow all algorithms from particular algorithm stores. Set
    # these stores here. They may be strings or regular expressions.
    {% if node.policies.allowed_algorithm_stores is defined %}
    allowed_algorithm_stores:
      {% for store in node.policies.allowed_algorithm_stores %}
      - {{ store }}
      {% endfor %}
    {% else %}
    # allowed_algorithm_stores:
    #   # allow all algorithms from the vantage6 community store
    #   - https://store.uluru.vantage6.ai
    #   # allow any store that is a subdomain of vantage6.ai
    #   - ^https://[a-z]+\.vantage6\.ai$
    {% endif %}

    # If you define both `allowed_algorithm_stores` and `allowed_algorithms`, you can
    # choose to only allow algorithms that both policies allow, or you can allow
    # algorithms that either of them allows. By default, only algorithms that are given
    # in *both* the `allowed_algorithms` and `allowed_algorithm_stores` are allowed by
    # setting this to the default value `false`.
    allow_either_whitelist_or_store: {{ node.policies.allow_either_whitelist_or_store | default(false) }}

    # Define which users are allowed to run algorithms on your node by their ID
    {% if node.policies.allowed_users is defined %}
    allowed_users:
      {% for user in node.policies.allowed_users %}
      - {{ user }}
      {% endfor %}
    {% else %}
    # allowed_users:
    #   - 2
    {% endif %}

    # Define which organizations are allowed to run images on your node by
    # their ID or name
    {% if node.policies.allowed_organizations is defined %}
    allowed_organizations:
      {% for org in node.policies.allowed_organizations %}
      - {{ org }}
      {% endfor %}
    {% else %}
    # allowed_organizations:
    #   - 6
    #   - root
    {% endif %}

    # Set to true to always require that the algorithm image is successfully pulled. This
    # ensures that no potentially outdated local images are used if internet connection
    # is not available. This option should be set to false if you are testing with local
    # algorithm images. Default value is true.
    require_algorithm_pull: {{ node.policies.require_algorithm_pull | default(true) }}
  {% else %}
  policies:
    # Control which algorithm images are allowed to run on this node. This is
    # expected to be a valid regular expression. If `production` is true, you must set
    # this and/or `allowed_algorithm_stores`, otherwise the node will not start.
    # allowed_algorithms:
    #   - ^ghcr\.io/vantage6/algorithm/[a-zA-Z]+/[a-zA-Z]+
    #   - ^myalgorithm\.ai/some-algorithm

    # It is also possible to allow all algorithms from particular algorithm stores. Set
    # these stores here. They may be strings or regular expressions.
    # allowed_algorithm_stores:
    #   # allow all algorithms from the vantage6 community store
    #   - https://store.uluru.vantage6.ai
    #   # allow any store that is a subdomain of vantage6.ai
    #   - ^https://[a-z]+\.vantage6\.ai$

    # If you define both `allowed_algorithm_stores` and `allowed_algorithms`, you can
    # choose to only allow algorithms that both policies allow, or you can allow
    # algorithms that either of them allows. By default, only algorithms that are given
    # in *both* the `allowed_algorithms` and `allowed_algorithm_stores` are allowed by
    # setting this to the default value `false`.
    # allow_either_whitelist_or_store: false

    # Define which users are allowed to run algorithms on your node by their ID
    # allowed_users:
    #   - 2
    # Define which organizations are allowed to run images on your node by
    # their ID or name
    # allowed_organizations:
    #   - 6
    #   - root

    # Set to true to always require that the algorithm image is successfully pulled. This
    # ensures that no potentially outdated local images are used if internet connection
    # is not available. This option should be set to false if you are testing with local
    # algorithm images. Default value is true.
    require_algorithm_pull: true
  {% endif %}

  # Prometheus settings, for sending system metadata to HQ.
  {% if node.prometheus is defined %}
  prometheus:
    # Whether or not to enable Prometheus reporting. Default is false.
    enabled: {{ node.prometheus.enabled | default(false) }}

    # Interval (in seconds) at which the node sends system metadata to HQ.
    # This should align with the Prometheus scrape_interval to avoid stale data.
    report_interval_seconds: {{ node.prometheus.report_interval_seconds | default(45) }}
  {% else %}
  prometheus:
    # Whether or not to enable Prometheus reporting. Default is false.
    enabled: false

    # Interval (in seconds) at which the node sends system metadata to HQ.
    # This should align with the Prometheus scrape_interval to avoid stale data.
    # report_interval_seconds: 45
  {% endif %}

  # Specify private Docker registries so that the node can login and pull private
  # algorithms.
  {% if node.private_docker_registries is defined %}
  private_docker_registries:
    {% for registry in node.private_docker_registries %}
    - registry: {{ registry.registry }}
      username: {{ registry.username }}
      password: {{ registry.password }}
    {% endfor %}
  {% else %}
  # private_docker_registries:
  #   - registry: my-private-registry.com
  #     username: my-username
  #     password: my-password
  {% endif %}

  # Provide additional environment variables to the algorithm containers. This can be
  # useful for instance to provide threshold values, database credentials, etc.
  # Note that variable names should consist of only letters, numbers and underscores,
  # and start with a letter.
  {% if node.algorithm_env is defined %}
  algorithm_env:
    {% for key, value in node.algorithm_env.items() %}
    {{ key }}: {{ value }}
    {% endfor %}
  {% else %}
  # algorithm_env:
  #     threshold_example: 10
  {% endif %}

  # Whitelisting settings to specify external addresses algorithms are allowed to
  # connect to. Only Kubernetes network policies are supported. See:
  #   https://kubernetes.io/docs/concepts/services-networking/network-policies
  # Only add egress destinations that are absolutely necessary for your algorithm
  # to function (for example, a required database server). Whitelists are defined
  # per task type. The allowed task types are: data_extraction, preprocessing,
  # federated_compute, central_compute, postprocessing.
  #
  # Each entry in the whitelist defines one allowed connection path. Multiple entries
  # are OR'd together (traffic is allowed if it matches any entry). You can specify:
  # - namespaceSelector: to allow connections to all pods in a namespace or a subset of
  #   pods in a namespace when used in combination with podSelector
  # - podSelector: to allow connections to pods matching labels (make sure that the
  #   namespace of this pod is whitelisted)
  # - ipBlock: to allow connections to IP addresses or CIDR ranges (e.g. a database
  #   server that is not part of the cluster)
  {% if node.whitelist is defined %}
  whitelist: {{ node.whitelist | tojson }}
  {% endif %}
  # whitelist:
  #   data_extraction:
  #     egress:
  #       - namespaceSelector:
  #         matchExpressions:
  #         - key: namespace
  #           operator: In
  #           values: ["some-namespace", "another-namespace"]
  #   preprocessing:
  #     egress: []
  #   federated_compute:
  #     egress: []
  #   central_compute:
  #     egress: []
  #   postprocessing:
  #     egress: []

  # Set to false to prevent creation of node secrets (useful when secrets are managed
  # externally)
  createSecrets: {{ node.createSecrets | default(true) }}

  {% if node.debug is defined %}
  # Debug settings
  debug:
    # Set to `true` to enable print debug messages from Flask/socketio.
    socketio: {{ node.debug.socketio | default(false) }}

    # Set to `true` to set the Flask app used for proxy service into debug mode.
    proxy_server: {{ node.debug.proxy_server | default(false) }}
  {% endif %}

  {% if node.dev is defined %}
  dev:
    # Set extension for the task directory. In the development environment, the task
    # directory is mounted as a volume. If multiple nodes are then running on the same
    # machine, this extension is added to the task directory to avoid conflicts.
    task_dir_extension: {{ node.dev.task_dir_extension }}
  {% endif %}
