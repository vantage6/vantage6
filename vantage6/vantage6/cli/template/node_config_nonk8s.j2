api_path: {{ api_path }}
production: false
encryption:
  enabled: false
logging:
  backup_count: 5
  datefmt: '%Y-%m-%d %H:%M:%S'
  file: {{ logging["file"] }}
  format: '%(asctime)s - %(name)-14s - %(levelname)-8s - %(message)s'
  level: DEBUG
  max_size: 1024
  use_console: true
  loggers:
  - level: warning
    name: urllib3
  - level: warning
    name: requests
  - level: warning
    name: engineio.client
  - level: warning
    name: kubernetes.client.rest
node_proxy_port: {{ node_proxy_port }}
port: {{ port }}
hq_url: {{ hq_url }}
release_name: {{ release_name }}
task_storage:
  claim_name: {{ task_claim_name }}
  sub_path: ""
  colocate_with_node: false
dev:
  task_dir_extension: {{ task_dir_extension }}
prometheus:
  enabled: {{ prometheus_enabled }}
  report_interval_seconds: 45
{{- user_provided_config -}}